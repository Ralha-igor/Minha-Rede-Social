<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <TextView
        android:id="@+id/textHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nova Publicação"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginTop="32dp"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/textHeader"
        app:layout_constraintBottom_toTopOf="@id/buttonPostar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/edit_text_rounded"
                android:backgroundTint="#9156FF"
                android:orientation="vertical"
                android:padding="16dp">

                <EditText
                    android:id="@+id/editPost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="O que você está pensando?"
                    android:textColorHint="#E1D5FF"
                    android:background="@null"
                    android:minLines="6"
                    android:gravity="top"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:inputType="textMultiLine|textCapSentences"
                    android:importantForAutofill="no" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imagePreview"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    android:scaleType="centerCrop"
                    android:background="#7F39FB"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent"
                    app:strokeColor="#FFFFFF"
                    app:strokeWidth="1dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/buttonSelecionarImagem"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="Adicionar Foto"
                android:textColor="#BB86FC"
                app:strokeColor="#BB86FC"
                android:textAllCaps="false"
                app:icon="@android:drawable/ic_menu_camera"
                app:iconTint="#BB86FC"
                app:cornerRadius="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="32dp"
                android:padding="4dp">

                <TextView
                    android:id="@+id/textCidade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📍 Localização: não detectada"
                    android:textColor="#999999"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/buttonLocalizacao"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ativar minha localização"
                    android:textAllCaps="false"
                    android:textColor="#BB86FC" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/buttonPostar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="24dp"
        android:text="PUBLICAR"
        android:textColor="#000000"
        android:textStyle="bold"
        android:textSize="16sp"
        android:backgroundTint="#BB86FC"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>